{
  "name": "@myendless1/codex-webui",
  "version": "1.2.0",
  "description": "Browser-based local console for Codex CLI, MCP, skills, and terminal sessions.",
  "type": "module",
  "bin": {
    "codex-webui": "server.js",
    "codex-webui-tunnel": "tunnel-client.js"
  },
  "files": [
    "server.js",
    "tunnel-client.js",
    "public",
    "README_EN.md",
    "docs"
  ],
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/myendless1/codex-webui.git"
  },
  "bugs": {
    "url": "https://github.com/myendless1/codex-webui/issues"
  },
  "homepage": "https://github.com/myendless1/codex-webui#readme",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "node server.js",
    "dev:lan": "HOST=0.0.0.0 node server.js",
    "start": "node server.js",
    "check": "node --check server.js && node --check tunnel-client.js && node --check public/app.js && node --check public/markdown-preview.js && node --check public/math-render.js",
    "test": "npm run check",
    "prepack": "npm test"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "dompurify": "^3.4.13",
    "marked": "^18.0.9",
    "node-pty": "^1.1.0",
    "ws": "^8.21.0"
  }
}
